#!/bin/sh
set -eu
APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PYTHONHOME="$APP_ROOT/runtime/desktop"
export PYTHONPATH="$APP_ROOT/runtime/desktop/lib/python3.14/site-packages"
export LD_LIBRARY_PATH="$APP_ROOT/runtime/native/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="$APP_ROOT/runtime/native/girepository-1.0"
export GST_PLUGIN_SYSTEM_PATH_1_0="$APP_ROOT/runtime/native/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$APP_ROOT/runtime/native/gstreamer-1.0/gst-plugin-scanner"
export GST_PLUGIN_PATH="$GST_PLUGIN_SYSTEM_PATH_1_0"
export GIO_EXTRA_MODULES="$APP_ROOT/runtime/native/gio/modules"
export GSETTINGS_SCHEMA_DIR="$APP_ROOT/runtime/native/share/glib-2.0/schemas"
export WEBKIT_EXEC_PATH="$APP_ROOT/runtime/native/webkit2gtk-4.1"
export WEBKIT_INJECTED_BUNDLE_PATH="$WEBKIT_EXEC_PATH/injected-bundle"
exec "$APP_ROOT/runtime/desktop/bin/python" "$APP_ROOT/linux-light/desktop.py" "$@"
